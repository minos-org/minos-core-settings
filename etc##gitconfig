;This file is part of the minos-core-settings package

[color]
[color "branch"]
    current = yellow reverse
    local   = yellow
    remote  = green
[color "diff"]
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
    added     = yellow
    changed   = green
    untracked = cyan

;Highlight whitespace in diffs

[color]
	ui = true
[color "diff"]
	whitespace = red reverse
	commit = yellow bold
[core]
    whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol

[alias]
    d       = diff
    cm      = commit
    cmv     = commit -v
    s       = show
    st      = status
    br      = branch
    co      = checkout
    unstage = reset HEAD --
    last    = log -1 HEAD
    praise  = blame
    discart = checkout --
    glog    = log --all --pretty='format:%d %Cgreen%h%Creset %an - %s' --graph

[core]
    editor = vim
	pager = "if command -v diff-so-fancy >/dev/null; then diff-so-fancy; else cat; fi | if command -v less >/dev/null; then less --tabs=4 -RFX; else more; fi"

[merge]
    tool = vimdiff

[push]
	default = simple
[credential]
	helper = cache --timeout=3600
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
